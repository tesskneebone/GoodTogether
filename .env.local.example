# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used server-side only, never exposed to the browser.
# See README.md "Opportunity photos" / "Importing opportunities" sections.

# Unsplash API access key (unsplash.com/developers) -- auto-illustrates
# opportunities with a relevant photo. Without this, opportunities just
# show no photo.
UNSPLASH_ACCESS_KEY=

# Supabase service_role secret (Project Settings -> API) -- required for
# the scraper import job to insert opportunities that have no owning org.
SUPABASE_SERVICE_ROLE_KEY=

# Any random string; authenticates requests to /api/cron/scrape.
CRON_SECRET=
